rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Permitir lectura pública de usuarios para login por nombre de usuario
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas generales para el resto de la app
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
